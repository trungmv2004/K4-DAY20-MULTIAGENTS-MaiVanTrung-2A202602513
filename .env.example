# Copy this file to .env and fill in the values. NEVER commit .env.
# Option 1 - Azure OpenAI or an OpenAI-compatible gateway (give all three):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_MODEL=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview   # only for real *.openai.azure.com endpoints

# Option 2 - another provider (leave Option 1 empty):
# LAB_MODEL=deepseek:deepseek-chat
# DEEPSEEK_API_KEY=

LAB_TEMPERATURE=0

# Option 3 - OpenRouter (replace the three Option 1 entries above with these).
# Put OPENROUTER_API_KEY BEFORE the interpolated AZURE_OPENAI_KEY.
# OPENROUTER_API_KEY=your-key-here
# AZURE_OPENAI_ENDPOINT=https://openrouter.ai/api/v1
# AZURE_OPENAI_KEY=${OPENROUTER_API_KEY}
# AZURE_OPENAI_DEPLOYMENT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Run with dotenv loading (do not pass interpolated .env via Docker --env-file).

# Option 4 - Gemini (leave all three Option 1 entries empty).
# GEMINI_API_KEY=your-key-here
# LAB_MODEL=google_genai:gemini-3.1-flash-lite
# LangChain accepts GEMINI_API_KEY directly; GOOGLE_API_KEY takes precedence
# if both are present. Never put credentials in LAB_MODEL or command arguments.
